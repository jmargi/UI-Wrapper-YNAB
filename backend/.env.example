# Copy this file to .env and fill in your own values.

# YNAB Personal Access Token — https://app.ynab.com/settings/developer
YNAB_API_KEY=your_ynab_personal_access_token_here

# ── AI Agent / LLM provider ─────────────────────────────────────────
# "ollama" = local, free, private (financial data never leaves your Mac).
# "anthropic" = Claude cloud API (paid).
LLM_PROVIDER=ollama

# Ollama settings (when LLM_PROVIDER=ollama).
# If the app runs in a container and Ollama runs natively on the host,
# use: http://host.docker.internal:11434  (or host.containers.internal for Podman)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Anthropic API key (only used when LLM_PROVIDER=anthropic).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=YOUR_KEY_HERE

YNAB_POLL_INTERVAL=120000
PORT=3001
NODE_ENV=development
